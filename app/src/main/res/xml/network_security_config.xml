<?xml version="1.0" encoding="utf-8"?>
<!--
    v47: Allow LAN cleartext HTTP for MomentUploader / pingDesktop.
    Android 9+ blocks cleartext by default, breaking LAN sync (http://192.168.x.x).
    Network security config does not support IP ranges, and desktop IP is
    user-configured at runtime, so global cleartext is required.

    P0 hardening: MomentUploader.isLocalNetworkHost() validates the target IP
    at code level (127.x / 10.x / 172.16-31.x / 192.168.x / localhost).
    Non-LAN cleartext HTTP requests are blocked, narrowing the attack surface.

    Risk: all network traffic is either GitHub (HTTPS) or user-configured LAN
    sync (optional token auth). Global cleartext does not expand the attack surface.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
